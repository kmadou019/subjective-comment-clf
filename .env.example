# .env.example
# Copy to .env and fill in real values. .env itself must NEVER be committed.

# --- Embeddings ---
# Hugging Face token used to call the embedding model (sentence-transformers).
# Get one at https://huggingface.co/settings/tokens (type: write).
HUGGINGFACE_API_KEY=hf_xxx

# Name of the sentence-transformer model used to embed comments before
# storing/querying them in ChromaDB. Must be the SAME model used to build
# the index and to query it, otherwise similarity search is meaningless.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Storage paths ---
# Relative to the rag/ folder, since chroma.py and rag.py are always run
# from inside rag/ (cd .../rag && ./chroma.py, or via script/rag.sh).

# Where the persistent ChromaDB collection lives (created by rag/chroma.py).
CHROMA_PERSIST_DIR=chroma_db

# CSV of human-labeled comments used to populate the vector store.
COMMENTS_CSV_PATH=data/comments.csv

# CSV of held-out comments used to evaluate the system (rag/rag.py).
TEST_CSV_PATH=data/test.csv

# --- Retrieval ---
# Number of similar labeled comments fetched from ChromaDB as few-shot
# context for the classification prompt. Current code behaviour = 1.
RETRIEVAL_K=1

# --- LLM provider ---
# Which backend graph_builder.py should use to run the classification LLM.
#   ollama          -> local model served by Ollama (default, no internet/API key needed)
#   huggingface_api -> Hugging Face Inference API (reuses HUGGINGFACE_API_KEY above,
#                      no separate account/key needed)
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Used when LLM_PROVIDER=huggingface_api. Hugging Face model id to call
# through the Inference API, e.g. mistralai/Mistral-7B-Instruct-v0.3
HF_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# --- GPU monitoring (rag/rag.py energy tracking via nvidia-smi) ---
# Set to false on any machine without an NVIDIA GPU (laptop, CI, Docker,
# HF Spaces) so the evaluation script doesn't try to shell out to
# nvidia-smi and crash. Default true preserves today's behaviour on the
# lab cluster, where rag.sh runs and nvidia-smi is always present.
ENABLE_GPU_MONITORING=true
